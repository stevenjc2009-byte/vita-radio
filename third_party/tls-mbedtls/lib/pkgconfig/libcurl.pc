prefix=/usr/local/vitasdk/arm-vita-eabi
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT MQTTS POP3 POP3S RTSP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc HSTS HTTPS-proxy libz SSL threadsafe zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
License: curl
Copyright: Copyright (C) Daniel Stenberg, <daniel@haxx.se>, et al.
Version: 8.22.0
Source: https://curl.se/download/curl-8.22.0.tar.gz
Requires: zlib,libzstd
Libs: -L${libdir} -lcurl -lmbedtls -lmbedx509 -lmbedcrypto -lz -lzstd -lz -lgcc -lc -lSceRtc_stub -lSceSysmem_stub -lSceKernelThreadMgr_stub -lSceKernelModulemgr_stub -lSceIofilemgr_stub -lSceProcessmgr_stub -lSceLibKernel_stub -lSceNet_stub -lSceNetCtl_stub -lSceSysmodule_stub
Libs.private: -lmbedtls -lmbedx509 -lmbedcrypto -lz -lzstd -lz -lgcc -lc -lSceRtc_stub -lSceSysmem_stub -lSceKernelThreadMgr_stub -lSceKernelModulemgr_stub -lSceIofilemgr_stub -lSceProcessmgr_stub -lSceLibKernel_stub -lSceNet_stub -lSceNetCtl_stub -lSceSysmodule_stub
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
Link.ABI: c
